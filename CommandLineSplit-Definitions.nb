Cell[BoxData[
 RowBox[{
  RowBox[{"bigCommandString", "=", 
   RowBox[{"StringRiffle", "[", "\[IndentingNewLine]", "\t", 
    RowBox[{
     RowBox[{"Flatten", " ", "@", " ", 
      RowBox[{"{", "\[IndentingNewLine]", "\t\t", 
       RowBox[{"\"\<tool\>\"", ",", "\[IndentingNewLine]", "\t\t", 
        RowBox[{"Table", "[", "\[IndentingNewLine]", "\t\t\t", 
         RowBox[{
          RowBox[{"{", "\[IndentingNewLine]", "\t\t\t\t", 
           RowBox[{
            RowBox[{"\"\<--flag\>\"", " ", "<>", " ", 
             RowBox[{"ToString", "[", "i", "]"}]}], ",", 
            "\[IndentingNewLine]", "\t\t\t\t", 
            
            RowBox[{"\"\<--name=\>\"", " ", "<>", " ", "\"\<\\\"value \>\"", 
             " ", "<>", " ", 
             RowBox[{"ToString", "[", "i", "]"}], " ", "<>", 
             " ", "\"\< with spaces\\\"\>\""}], ",", "\[IndentingNewLine]", 
            "\t\t\t\t", 
            RowBox[{"\"\<'single quoted argument \>\"", " ", "<>", " ", 
             RowBox[{"ToString", "[", "i", "]"}], " ", "<>", 
             " ", "\"\<'\>\""}], ",", "\[IndentingNewLine]", "\t\t\t\t", 
            RowBox[{"\"\<plainArgument\>\"", " ", "<>", " ", 
             RowBox[{"ToString", "[", "i", "]"}]}], ",", 
            "\[IndentingNewLine]", "\t\t\t\t", 
            RowBox[{"\"\<escaped\\\\ space\>\"", " ", "<>", " ", 
             RowBox[{"ToString", "[", "i", "]"}]}], ",", 
            "\[IndentingNewLine]", "\t\t\t\t", 
            
            RowBox[{"\"\<\\\"embedded \\\\\\\"double quotes\\\\\\\" item \>\"",
              " ", "<>", " ", 
             RowBox[{"ToString", "[", "i", "]"}], " ", "<>", 
             " ", "\"\<\\\"\>\""}], ",", "\[IndentingNewLine]", 
            "\t\t\t\t", "\"\<''\>\"", ",", "\[IndentingNewLine]", 
            "\t\t\t\t", "\"\<\\\"\\\"\>\"", ",", "\[IndentingNewLine]", 
            "\t\t\t\t", 
            RowBox[{"\"\<--path=/tmp/folder\>\"", " ", "<>", " ", 
             RowBox[{"ToString", "[", "i", "]"}], " ", "<>", 
             " ", "\"\</file\>\"", " ", "<>", " ", 
             RowBox[{"ToString", "[", "i", "]"}], " ", "<>", 
