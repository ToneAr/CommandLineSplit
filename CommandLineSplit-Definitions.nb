Cell[TextData[{
 Cell[BoxData["CommandLineSplit"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "eef335aa-40aa-475a-b616-73b645f9f052"],
 " is compiled to native code using ",
 Cell[BoxData[
  TagBox[
   ButtonBox[
    StyleBox["FunctionCompile", "SymbolsRefLink",
     ShowStringCharacters->True,
     FontFamily->"Source Sans Pro"],
    BaseStyle->Dynamic[
      FEPrivate`If[
       CurrentValue["MouseOver"], {
       "Link", FontColor -> RGBColor[0.8549, 0.39608, 0.1451]}, {"Link"}]],
    ButtonData->"paclet:ref/FunctionCompile",
    ContentPadding->False],
   MouseAppearanceTag["LinkHand"]]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "0162e655-7d29-4559-abf2-308c430b3d8e"],
 " and as such, fist time evaluation involves this slow compilation step \
which is then cached using ",
